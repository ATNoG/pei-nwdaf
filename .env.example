# =============================================================================
# NWDAF Environment Configuration
# =============================================================================
# Copy to .env and adjust values as needed.
# All defaults here are wired for the full stack running on a single machine.
# =============================================================================

# ─── Kafka ───────────────────────────────────────────────────────────────────
KAFKA_HOST=kafka
KAFKA_PORT=9092
KAFKA_NODE_ID=1
KAFKA_CONTROLLER_PORT=9093
KAFKA_NUM_PARTITIONS=3

# ─── Storage — InfluxDB ──────────────────────────────────────────────────────
INFLUX_PORT=8086
INFLUX_ADMIN_USER=admin
INFLUX_ADMIN_PASSWORD=changeme
INFLUX_ORG=myorg
INFLUX_BUCKET=mybucket
INFLUX_TOKEN=my-super-secret-influx-token

# ─── Storage — ClickHouse ────────────────────────────────────────────────────
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_TCP_PORT=9000
CLICKHOUSE_DB=analytics
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# ─── Policy ──────────────────────────────────────────────────────────────────
POLICY_SERVICE_URL=http://policy-service:8788
POLICY_COMPONENT_ID=data-storage
POLICY_ENABLED=false
POLICY_FAILOPEN=true
POLICY_ROLENAME=Storage

# ─── Permit.io ───────────────────────────────────────────────────────────────
# Requires real keys for the policy service to start.
# Other services are unaffected while POLICY_ENABLED=false.
PERMIT_API_KEY=your-permit-api-key
PDP_API_KEY=your-permit-api-key
PERMIT_PDP_URL=http://permit:7000
PDP_DEBUG=false
AUTO_CREATE_ATTRIBUTES=true
DECISION_CACHE_TTL=60
REQUIRE_REGISTRATION=false
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# ─── ML — PostgreSQL ─────────────────────────────────────────────────────────
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=mlflow

# ─── ML — MinIO ──────────────────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_HOST=mlflow-minio
MINIO_PORT=9000
MINIO_HOST_PORT=9002
MINIO_CONSOLE_HOST_PORT=9003
MINIO_BUCKET=mlflow

# ─── ML — MLflow ─────────────────────────────────────────────────────────────
MLFLOW_VERSION=v3.10.1
MLFLOW_BIND_HOST=0.0.0.0
MLFLOW_HOST=mlflow
MLFLOW_PORT=5000
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_S3_ENDPOINT_URL=http://mlflow-minio:9000
MLFLOW_BACKEND_STORE_URI=postgresql://mlflow:mlflow@mlflow-postgres:5432/mlflow
MLFLOW_DEFAULT_ARTIFACT_ROOT=s3://mlflow

# ─── ML — Service ────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8060
LOG_LEVEL=INFO
AWS_DEFAULT_REGION=us-east-1
DATA_STORAGE_API_URL=http://data-storage:8000
DATA_STORAGE_EXAMPLE_ENDPOINT=/api/v1/processed/example
DATA_STORAGE_DATA_ENDPOINT=/api/v1/processed
DATA_STORAGE_CELL_ENDPOINT=/api/v1/cell
DATA_STORAGE_EXCLUDED_FIELDS=
DATABASE_URL=postgresql://mlflow:mlflow@mlflow-postgres:5432/mlflow
SLACK_NOTIFY=false
SLACK_WEBHOOK_URL=
KAFKA_OUTPUT_TOPIC=network.ml.results

# ─── Decision ────────────────────────────────────────────────────────────────
DPORT=8090
LLM_URL=http://localhost:11434
LLM_API_KEY=ollama
LLM_MODEL=llama3.2
BLACKLIST_ENABLED=true

# ─── Frontend — Nginx ────────────────────────────────────────────────────────
NGINX_PORT1=80
NGINX_PORT2=443
KEYCLOAK_HOST=keycloak
KEYCLOAK_PORT=8080
POLICY_HOST=policy-service
POLICY_PORT=8788
DASHBOARD_HOST=frontend
DASHBOARD_PORT=5173
ML_HOST=pei-ml
ML_PORT=8060
DECISION_HOST=decision-service
DECISION_PORT=8090
DATA_INGESTION_HOST=data-ingestion
DATA_INGESTION_PORT=7000
MLFLOW_HOST=mlflow
MLFLOW_PORT=5000

# ─── Frontend — Vite ─────────────────────────────────────────────────────────
VITE_ML_HOST=pei-ml
VITE_DATA_STORAGE_HOST=data-storage
VITE_MLFLOW_URL=/mlflow
VITE_RAW_DATA_URL=http://localhost:7000
VITE_DATA_STORAGE_URL=http://localhost:8000
VITE_ML_URL=http://localhost:8060
VITE_POLICY_SERVICE_URL=
VITE_AVAILABLE_COMPONENTS=
