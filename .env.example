# =============================================================================
# NWDAF Environment Configuration
# =============================================================================

## CHANGE ME ----------------------

# ML
TRAIN_MAX_EPOCHS=10
ADD_TEST_MODELS=true

SLACK_NOTIFY=false      # send performance notifications via slack
SLACK_WEBHOOK_URL=
KC_HOSTNAME=localhost # change to your domain
INFLUX_INIT_MODE=setup
INFLUX_ADMIN_USER=admin
INFLUX_ADMIN_PASSWORD=changeme123
INFLUX_ORG=nwdaf
INFLUX_BUCKET=raw
INFLUX_TOKEN=nwdaf-dev-token-change-in-production

CLICKHOUSE_DB=analytics
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

SLIDE_INTERVAL_60=20 # slide interval for sliding windows
# SLIDE_INTERVAL_300=45

POLICY_ENABLED=false
PERMIT_API_KEY=permit_key_placeholder

LLM_URL=localhost      # change me
LLM_API_KEY=my-api-key # change me
LLM_MODEL=llama3.1:8b  # change me

POSTGRES_USER=mlflow
POSTGRES_PASSWORD=mlflow

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=mlflow

TRAIN_USE_KUBE=false    # run train inside of a kube cluster
TRAIN_KUBE_HOST=https://your-cluster-api-server:6443
TRAIN_KUBE_TOKEN=<ServiceAccount token>
TRAIN_KUBE_CA_CERT=<base64-encoded PEM certificate>
TRAIN_KUBE_NAMESPACE=default

ENCRYPTION_ENABLED=false # share datastorage data using encryption
DLT_ENABLED=false # enable chain

## KEEP ME ------------------------

POLICY_FAILOPEN=true
PDP_DEBUG=false
AUTO_CREATE_ATTRIBUTES=true
DECISION_CACHE_TTL=60
REQUIRE_REGISTRATION=false

DATA_INGESTION_HOST=data-ingestion
MLFLOW_HOST=mlflow-server
CLICKHOUSE_HOST=clickhouse
DATA_STORAGE_HOST=data-storage
PERMIT_PDP_HOST=permit-pdp
INGESTION_HOST=data-ingestion
NGINX_HOST=nginx
POLICY_HOST=policy-service
ML_HOST=pei-ml
DASHBOARD_HOST=frontend
DECISION_HOST=decision-service
KAFKA_HOST=kafka-1
INFLUX_HOST=influxdb
MINIO_HOST=mlflow-minio
POSTGRES_HOST=mlflow-postgres
KEYCLOAK_HOST=keycloak

# ─── Ports ───────────────────────────────────────────────────────────────────
INFLUX_PORT=8086
INGESTION_PORT=7000
DATA_INGESTION_PORT=7000
ML_PORT=8060
NGINX_PORT1=80
NGINX_PORT2=443
DASHBOARD_PORT=5173
KEYCLOAK_PORT=8080
POLICY_PORT=8788
DECISION_PORT=6789
KAFKA_PORT=9092
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_TCP_PORT=9000
MINIO_PORT=9000
MINIO_HOST_PORT=9002
MINIO_CONSOLE_HOST_PORT=9003
MLFLOW_PORT=5000
DATA_STORAGE_PORT=8000
POLICY_SERVICE_PORT=8788
PERMIT_PDP_PORT=7766
POSTGRES_PORT=5432

# ─── URLs ────────────────────────────────────────────────────────────────────
DATA_STORAGE_API_URL=http://$DATA_STORAGE_HOST:$DATA_STORAGE_PORT
INFLUX_URL=http://$INFLUX_HOST:$INFLUX_PORT
POLICY_SERVICE_URL=http://$POLICY_SERVICE_HOST:$POLICY_SERVICE_PORT
DASHBOARD_URL=http://$DASHBOARD_HOST:$DASHBOARD_PORT
KAFKA_BOOTSTRAP_SERVERS=$KAFKA_HOST:$KAFKA_PORT
PERMIT_PDP_URL=http://$PERMIT_PDP_HOST:$PERMIT_PDP_PORT

VITE_MLFLOW_URL=/mlflow
VITE_RAW_DATA_URL=http://$INGESTION_HOST:$INGESTION_PORT
VITE_DATA_STORAGE_URL=data-storage
VITE_ML_URL=pei-ml
VITE_ML_HOST=pei-ml
VITE_DATA_STORAGE_HOST=data-storage
VITE_POLICY_SERVICE_URL=
VITE_AVAILABLE_COMPONENTS=

# ─── MLflow ──────────────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://$MLFLOW_HOST:$MLFLOW_PORT
MLFLOW_S3_ENDPOINT_URL=http://$MINIO_HOST:$MINIO_PORT
MLFLOW_BACKEND_STORE_URI=postgresql://$POSTGRES_USER:$POSTGRES_PASSWORD@$POSTGRES_HOST:$POSTGRES_PORT/mlflow

# ─── Kafka ───────────────────────────────────────────────────────────────────
# Generate once: docker run --rm apache/kafka:4.1.1 kafka-storage random-uuid
KAFKA_CLUSTER_ID=
KAFKA_NUM_PARTITIONS=3

# ─── Decision / LLM ──────────────────────────────────────────────────────────
LLM_PROMPT_PATH=llm/prompt.txt
LLM_SYSTEM_PATH=llm/system.txt
LLM_TEMPERATURE=0.3
LLM_TOP_K=10
LLM_TOP_P=0.9
LLM_NUM_PREDICT=1024
LLM_REPEAT_PENALTY=1.3
LLM_TIMEOUT=60
BLACKLIST_ENABLED=true
DECISION_HISTORY_SIZE=20

# ─── MLflow Config ───────────────────────────────────────────────────────────
MLFLOW_VERSION=v3.10.1
MLFLOW_BIND_HOST=0.0.0.0
MLFLOW_DEFAULT_ARTIFACT_ROOT=s3://mlflow

# ─── ML Service ──────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
AWS_DEFAULT_REGION=us-east-1

DATA_STORAGE_EXAMPLE_ENDPOINT=/api/v1/processed/example
DATA_STORAGE_DATA_ENDPOINT=/api/v1/processed
DATA_STORAGE_CELL_ENDPOINT=/api/v1/cell
DATA_STORAGE_EXCLUDED_FIELDS=

DATABASE_URL=postgresql://$POSTGRES_USER:$POSTGRES_PASSWORD@$POSTGRES_HOST:$POSTGRES_PORT/mlflow

TRAIN_KUBE_IMAGE=vcnt00/pei-ml-train-worker:latest
# Override URLs for k3s pods (set to external IPs when k3s can't reach Docker hostnames)
TRAIN_KUBE_MLFLOW_URI=
TRAIN_KUBE_MLFLOW_S3=
TRAIN_KUBE_DB_URL=
TRAIN_KUBE_DATA_STORAGE_URL=

DLT_SIDECAR_URL=http://fabric-client-sidecar:8080
DLT_TIMEOUT=10.0
