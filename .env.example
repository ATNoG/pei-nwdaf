# =============================================================================
# NWDAF Environment Configuration (Example – Single Machine / Localhost)
# =============================================================================

# ─── Hosts ───────────────────────────────────────────────────────────────────
DATA_INGESTION_HOST=localhost
MLFLOW_HOST=localhost
CLICKHOUSE_HOST=localhost
DATA_STORAGE_HOST=localhost
PERMIT_PDP_HOST=localhost
INGESTION_HOST=localhost
NGINX_HOST=localhost
POLICY_SERVICE_HOST=localhost
ML_HOST=localhost
DASHBOARD_HOST=localhost
DECISION_HOST=localhost
KAFKA_HOST=localhost
INFLUX_HOST=localhost
MINIO_HOST=localhost
POSTGRES_HOST=localhost

# ─── Ports ───────────────────────────────────────────────────────────────────
INFLUX_PORT=8086
INGESTION_PORT=7000
DATA_INGESTION_PORT=7000 # todo: remove this :)
ML_PORT=8060
NGINX_PORT1=80
NGINX_PORT2=443
DASHBOARD_PORT=5173
KEYCLOAK_PORT=8080
POLICY_PORT=8788
DECISION_PORT=6789
KAFKA_PORT=9092
KAFKA_CONTROLLER_PORT=9093
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_TCP_PORT=9000
MINIO_PORT=9000
MINIO_HOST_PORT=9002
MINIO_CONSOLE_HOST_PORT=9003
MLFLOW_PORT=5000
DATA_STORAGE_PORT=8000
POLICY_SERVICE_PORT=8788
PERMIT_PDP_PORT=7766
POSTGRES_PORT=5432

# ─── URLs ────────────────────────────────────────────────────────────────────
DATA_STORAGE_API_URL=http://$DATA_STORAGE_HOST:$DATA_STORAGE_PORT
INFLUX_URL=http://$INFLUX_HOST:$INFLUX_PORT
POLICY_SERVICE_URL=http://$POLICY_SERVICE_HOST:$POLICY_SERVICE_PORT
DASHBOARD_URL=http://$DASHBOARD_HOST:$DASHBOARD_PORT
KAFKA_BOOTSTRAP_SERVERS=$KAFKA_HOST:$KAFKA_PORT
PERMIT_PDP_URL=http://$PERMIT_PDP_HOST:$PERMIT_PDP_PORT

VITE_MLFLOW_URL=/mlflow
VITE_RAW_DATA_URL=http://$INGESTION_HOST:$INGESTION_PORT
VITE_DATA_STORAGE_URL=http://$DATA_STORAGE_HOST:$DATA_STORAGE_PORT
VITE_ML_URL=http://$ML_HOST:$ML_PORT
VITE_POLICY_SERVICE_URL=
VITE_AVAILABLE_COMPONENTS=

# ─── MLflow ──────────────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://$MLFLOW_HOST:$MLFLOW_PORT
MLFLOW_S3_ENDPOINT_URL=http://$MINIO_HOST:$MINIO_PORT
MLFLOW_BACKEND_STORE_URI=postgresql://<mlflow_user>:<mlflow_password>@$POSTGRES_HOST:$POSTGRES_PORT/mlflow

# ─── Kafka ───────────────────────────────────────────────────────────────────
KAFKA_NODE_ID=1
KAFKA_NUM_PARTITIONS=3

# ─── InfluxDB ────────────────────────────────────────────────────────────────
INFLUX_INIT_MODE=setup
INFLUX_ADMIN_USER=<admin_user>
INFLUX_ADMIN_PASSWORD=<admin_password>
INFLUX_ORG=<org>
INFLUX_BUCKET=<bucket>
INFLUX_TOKEN=<influx_token>

# ─── ClickHouse ──────────────────────────────────────────────────────────────
CLICKHOUSE_DB=analytics
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=<clickhouse_password>

# ─── Processor ───────────────────────────────────────────────────────────────
SLIDE_INTERVAL_60=20
SLIDE_INTERVAL_300=45

# ─── Policy ──────────────────────────────────────────────────────────────────
POLICY_ENABLED=true
POLICY_FAILOPEN=true
PERMIT_API_KEY=<permit_api_key>
PDP_DEBUG=false
AUTO_CREATE_ATTRIBUTES=true
DECISION_CACHE_TTL=60
REQUIRE_REGISTRATION=false

# ─── Decision / LLM ──────────────────────────────────────────────────────────
LLM_URL=https://<llm-endpoint>
LLM_API_KEY=<llm_api_key>
LLM_MODEL=qwen2.5:3b
BLACKLIST_ENABLED=true

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_USER=<postgres_user>
POSTGRES_PASSWORD=<postgres_password>

# ─── MinIO ───────────────────────────────────────────────────────────────────
MINIO_ROOT_USER=<minio_user>
MINIO_ROOT_PASSWORD=<minio_password>
MINIO_BUCKET=mlflow

# ─── MLflow Config ───────────────────────────────────────────────────────────
MLFLOW_VERSION=vX.X.X
MLFLOW_BIND_HOST=0.0.0.0
MLFLOW_DEFAULT_ARTIFACT_ROOT=s3://mlflow

# ─── ML Service ──────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
AWS_DEFAULT_REGION=us-east-1

DATA_STORAGE_EXAMPLE_ENDPOINT=/api/v1/processed/example
DATA_STORAGE_DATA_ENDPOINT=/api/v1/processed
DATA_STORAGE_CELL_ENDPOINT=/api/v1/cell
DATA_STORAGE_EXCLUDED_FIELDS=

DATABASE_URL=postgresql://<db_user>:<db_password>@localhost:5432/<db_name>

SLACK_NOTIFY=false
SLACK_WEBHOOK_URL=<slack_webhook_url>

KAFKA_OUTPUT_TOPIC=network.ml.results
